{
  "name": "makai",
  "version": "0.1.0",
  "description": "TypeScript SDK for Makai stdio client transport",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build:sdk": "tsc -p tsconfig.json",
    "check:declarations": "npm run build:sdk && node scripts/check-npm-declarations.mjs",
    "test:sdk": "npm run build:sdk && node --test dist/test/**/*.test.js",
    "demo:start": "npm run build:sdk && node dist/demo/server.js",
    "test": "npm run test:sdk"
  },
  "keywords": [
    "makai",
    "sdk",
    "typescript",
    "stdio"
  ],
  "author": "makai contributors",
  "license": "ISC",
  "type": "commonjs",
  "bin": {
    "makai": "bin/makai.js"
  },
  "files": [
    "dist/src/**/*",
    "bin/makai.js",
    "README.md"
  ],
  "optionalDependencies": {
    "@makai/cli-darwin-arm64": "0.1.0",
    "@makai/cli-darwin-x64": "0.1.0",
    "@makai/cli-linux-arm64": "0.1.0",
    "@makai/cli-linux-x64": "0.1.0",
    "@makai/cli-win32-x64": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "nanoid": "^5.1.5",
    "ulid": "^3.0.2"
  }
}
